{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1180px"
    },
    "color": {
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "custom": true,
      "palette": [
        { "slug": "base", "name": "Basis", "color": "#fbfaf7" },
        { "slug": "contrast", "name": "Tekst", "color": "#15130f" },
        { "slug": "primary", "name": "Primair", "color": "#315c4d" },
        { "slug": "secondary", "name": "Secundair", "color": "#d8a25e" },
        { "slug": "accent", "name": "Accent", "color": "#8f3f34" },
        { "slug": "muted", "name": "Zacht", "color": "#ede8df" },
        { "slug": "surface", "name": "Vlak", "color": "#ffffff" }
      ],
      "gradients": [
        {
          "slug": "warm-hero",
          "name": "Warm hero",
          "gradient": "linear-gradient(135deg, var(--wp--preset--color--base) 0%, var(--wp--preset--color--muted) 50%, #f4dcc1 100%)"
        },
        {
          "slug": "primary-glow",
          "name": "Primair gloed",
          "gradient": "radial-gradient(circle at top left, rgba(216, 162, 94, .35), transparent 32%), linear-gradient(135deg, var(--wp--preset--color--primary), #15362d)"
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "20", "name": "2XS", "size": "clamp(0.44rem, 0.39rem + 0.24vw, 0.56rem)" },
        { "slug": "30", "name": "XS", "size": "clamp(0.69rem, 0.61rem + 0.37vw, 0.88rem)" },
        { "slug": "40", "name": "S", "size": "clamp(1rem, 0.9rem + 0.49vw, 1.25rem)" },
        { "slug": "50", "name": "M", "size": "clamp(1.5rem, 1.3rem + 0.98vw, 2rem)" },
        { "slug": "60", "name": "L", "size": "clamp(2rem, 1.61rem + 1.95vw, 3rem)" },
        { "slug": "70", "name": "XL", "size": "clamp(3rem, 2.22rem + 3.9vw, 5rem)" },
        { "slug": "80", "name": "2XL", "size": "clamp(4rem, 2.44rem + 7.8vw, 8rem)" }
      ],
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "typography": {
      "fluid": true,
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        },
        {
          "slug": "heading",
          "name": "Heading",
          "fontFamily": "'Fraunces', Georgia, serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Klein", "size": "clamp(0.89rem, 0.86rem + 0.12vw, 0.95rem)" },
        { "slug": "medium", "name": "Normaal", "size": "clamp(1rem, 0.95rem + 0.24vw, 1.13rem)" },
        { "slug": "large", "name": "Groot", "size": "clamp(1.35rem, 1.16rem + 0.95vw, 1.84rem)" },
        { "slug": "x-large", "name": "Extra groot", "size": "clamp(2rem, 1.42rem + 2.93vw, 3.5rem)" },
        { "slug": "jumbo", "name": "Jumbo", "size": "clamp(3rem, 1.83rem + 5.85vw, 6rem)" }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "slug": "soft", "name": "Zacht", "shadow": "0 18px 60px rgba(21, 19, 15, .10)" },
        { "slug": "lift", "name": "Lift", "shadow": "0 24px 80px rgba(49, 92, 77, .18)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--50)",
      "padding": {
        "top": "0",
        "right": "var(--wp--preset--spacing--40)",
        "bottom": "0",
        "left": "var(--wp--preset--spacing--40)"
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "elements": {
      "button": {
        "border": { "radius": "999px" },
        "color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--base)" },
        "spacing": { "padding": { "top": ".82rem", "right": "1.2rem", "bottom": ".82rem", "left": "1.2rem" } },
        "typography": { "fontWeight": "700" }
      },
      "heading": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "700", "lineHeight": "1.05" }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "700" }
      },
      "core/button": {
        "variations": {
          "ghost": {
            "border": { "color": "currentColor", "radius": "999px", "style": "solid", "width": "1px" },
            "color": { "background": "transparent", "text": "var(--wp--preset--color--primary)" }
          }
        }
      },
      "core/group": {
        "variations": {
          "glass-card": {
            "border": { "color": "rgba(255,255,255,.55)", "radius": "28px", "style": "solid", "width": "1px" },
            "shadow": "var(--wp--preset--shadow--soft)",
            "color": { "background": "rgba(255,255,255,.72)" },
            "spacing": { "padding": { "top": "var(--wp--preset--spacing--50)", "right": "var(--wp--preset--spacing--50)", "bottom": "var(--wp--preset--spacing--50)", "left": "var(--wp--preset--spacing--50)" } }
          }
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "blank", "title": "Leeg canvas", "postTypes": ["page", "post"] }
  ]
}
